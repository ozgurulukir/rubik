#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "rubik"
require "optparse"

# Global SIGINT safety net. The REPL installs its own "INT" handler while
# running so a Ctrl+C during a command raises Interrupt (and Reline chains to it
# as its old handler). This catch-all at the top level guarantees that an
# interrupt that occurs before the REPL loop starts -- or any situation where an
# inner handler has been left uninstalled -- always terminates the process, so
# the user is never stuck unable to exit.
trap("INT") do
  $stderr.puts "\n[rubik] Interrupted. Exiting."
  exit!(130)
end

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: rubik [options]"

  opts.on("-v", "--version", "Show version") do
    puts "rubik version #{Rubik::VERSION}"
    Kernel.exit(0)
  end

  opts.on("-h", "--help", "Show help") do
    puts opts
    Kernel.exit(0)
  end

  opts.on("-c", "--continue [SESSION_ID]", "Resume previous session (default: latest recorded session)") do |sid|
    options[:continue] = sid || :latest
  end

  opts.on("--list-sessions", "List all past sessions for current workspace") do
    sessions = Rubik::Session::Manager.list_sessions(Dir.pwd)
    if sessions.empty?
      puts "No recorded sessions found for #{Dir.pwd}."
    else
      puts "=== Recorded Sessions for #{File.basename(Dir.pwd)} (#{sessions.size}) ==="
      sessions.each_with_index do |s, idx|
        puts "  #{idx + 1}. #{s[:id]} (#{s[:scope]}) - #{s[:event_count]} events - Last: \"#{s[:last_prompt]}\""
      end
    end
    Kernel.exit(0)
  end

  opts.on("-s", "--script FILE", "Execute script file in non-interactive mode") do |file|
    options[:script] = file
  end
end.parse!

shell = Rubik::REPL::Shell.new

if options[:continue]
  res = shell.resume_session(options[:continue])
  unless res[:ok]
    warn "[Rubik] Warning: #{res[:error]}"
  end
end

if options[:script]
  unless File.exist?(options[:script])
    warn "Script file not found: #{options[:script]}"
    Kernel.exit(1)
  end
  File.open(options[:script]) do |f|
    shell.run(f)
  end
else
  shell.run
end
